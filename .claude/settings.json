{
  "permissions": {
    "allow": [
      "Bash(pip install*)",
      "Bash(pip list*)",
      "Bash(pip show*)",
      "Bash(pytest*)",
      "Bash(python -m scripts.run_pipeline*)",
      "Bash(python -m pytest*)",
      "Bash(python -c *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git stash*)",
      "Bash(git checkout*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(mkdir*)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(du *)",
      "Bash(find *)",
      "Bash(arm-none-eabi-gcc*)",
      "mcp__pylance_mcp_server__*",
      "mcp__gitkraken__*",
      "mcp__io_github_github_github-mcp-server__*"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(pip install --upgrade pip*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "python -m pytest tests/ -q --tb=line 2>&1 | tail -5"
          }
        ]
      },
      {
        "matcher": "Bash(git push*)",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[pre-push] Verifying tests pass...' && python -m pytest tests/ -q --tb=line 2>&1 | tail -5"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[hook] File modified — remember to run /test before committing'"
          }
        ]
      },
      {
        "matcher": "Bash(python -m scripts.run_pipeline*)",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os, sys; files=['tiny_ids_tnn_weights.h','tiny_ids_tnn_inference.c','tiny_ids_lr_weights.h','tiny_ids_lr_inference.c','tiny_ids_dt_weights.h','tiny_ids_dt_inference.c']; d='output'; missing=[f for f in files if not os.path.exists(os.path.join(d,f))]; print('[hook] All C artifacts generated ✓') if not missing else print(f'[hook] WARNING: Missing artifacts: {missing}')\""
          }
        ]
      },
      {
        "matcher": "Bash(pytest*)|Bash(python -m pytest*)",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[hook] Tests complete — check for failures above'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[notification] Task completed'"
          }
        ]
      }
    ]
  }
}
