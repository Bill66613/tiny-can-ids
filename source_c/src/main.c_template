#ifndef CAN_FRAME_T_DEFINED
#define CAN_FRAME_T_DEFINED
typedef struct
{
	double timestamp;
	uint32_t id;
	uint8_t dlc;
	uint8_t data[8];
} CAN_Frame_t;
#endif

typedef enum
{
	ATTACK_DOS,
	ATTACK_FUZZY,
	ATTACK_GEAR,
	ATTACK_RPM,
	ATTACK_UNKNOWN
} attack_type_t;

typedef enum
{
	MODEL_DT,
	MODEL_TNN,
	MODEL_LR,
	MODEL_UNKNOWN
} model_type_t;

typedef struct
{
	attack_type_t attack_type;
	model_type_t model;
	const char *interface_name;
	int frame_count;
	int slide_percent; /* 1..100, percent of frame_count to advance per dispatch */
	int timeout_sec; /* <= 0 means run forever */
	bool verbose;
} app_config_t;

static const char *attack_type_to_string(attack_type_t attack_type);
static const char *model_type_to_string(model_type_t model);

/* ---------------------------------------------------------------------------
 * Handler table: one entry per (attack_type, model) combination.
 * Defined outside #ifdef __linux__ so select_frame_count can use window_size
 * without duplicating the values.
 * ---------------------------------------------------------------------------
 * Each entry holds:
 *   - fn           : function pointer matching process_window_fn_t
 *   - window_size  : expected frame_count for this model
 *   - label        : human-readable name for log output
 * --------------------------------------------------------------------------- */
typedef void (*process_window_fn_t)(const CAN_Frame_t *window, int *result);

typedef struct
{
	attack_type_t attack_type;
	model_type_t model;
	process_window_fn_t fn;
	int window_size;
	const char *label;
} handler_entry_t;

static const handler_entry_t g_handler_table[] = {
// ##TAG_2
};

static const int g_handler_table_size =
	(int)(sizeof(g_handler_table) / sizeof(g_handler_table[0]));

#define DEFAULT_WINDOW_SIZE 10
#define MAX_ATTACK_SESSIONS 100

typedef struct {
    int session_id;
    int start_window;
    int end_window;
    double start_ts;
    double end_ts;
    double duration;
} AttackSessionLog_t;

// Global tracking variables for statistical summary
static int g_total_windows_processed = 0;
static int g_total_attack_windows = 0;

// Session tracking variables
static bool g_in_attack_state = false;
static int g_attack_session_count = 0;
static int g_current_session_start_window = -1;
static double g_current_session_start_ts = -1.0;
static double g_last_seen_attack_ts = -1.0;
static int g_last_seen_attack_window = -1;

// In-memory array to hold the history of attack sessions
static AttackSessionLog_t g_session_history[MAX_ATTACK_SESSIONS];

#ifdef __linux__
#define MAX_WINDOW_FRAMES 2048

static volatile sig_atomic_t g_stop_requested = 0;

static void handle_stop_signal(int signum)
{
	(void)signum;
	g_stop_requested = 1;
}

static int open_can_socket(const char *interface_name)
{
	int fd = socket(PF_CAN, SOCK_RAW, CAN_RAW);
	if (fd < 0)
	{
		perror("socket(PF_CAN)");
		return -1;
	}

	struct ifreq ifr;
	memset(&ifr, 0, sizeof(ifr));
	snprintf(ifr.ifr_name, IFNAMSIZ, "%s", interface_name);

	if (ioctl(fd, SIOCGIFINDEX, &ifr) < 0)
	{
		perror("ioctl(SIOCGIFINDEX)");
		close(fd);
		return -1;
	}

	struct sockaddr_can addr;
	memset(&addr, 0, sizeof(addr));
	addr.can_family = AF_CAN;
	addr.can_ifindex = ifr.ifr_ifindex;

	if (bind(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0)
	{
		perror("bind(AF_CAN)");
		close(fd);
		return -1;
	}

	return fd;
}

static double now_timestamp_s(void)
{
	struct timespec ts;
	clock_gettime(CLOCK_REALTIME, &ts);
	return (double)ts.tv_sec  + ((double)ts.tv_nsec / 1000000000.0);
}

static void process_can_window_x(
	const CAN_Frame_t *window,
	int start_index,
	int frame_count,
	const app_config_t *cfg)
{
	int oldest_idx = start_index;
	int newest_idx = (start_index + frame_count - 1) % frame_count;
	uint32_t oldest_id = window[oldest_idx].id & CAN_SFF_MASK;
	uint32_t newest_id = window[newest_idx].id & CAN_SFF_MASK;

	printf(
		"[X] process window attack=%s model=%s size=%d oldest=0x%03X newest=0x%03X\n",
		attack_type_to_string(cfg->attack_type),
		model_type_to_string(cfg->model),
		frame_count,
		oldest_id,
		newest_id);
}

static int dispatch_process_window(
	const CAN_Frame_t *window,
	int start_index,
	int frame_count,
	const app_config_t *cfg)
{
	g_total_windows_processed++;
	CAN_Frame_t ordered_window[MAX_WINDOW_FRAMES];
	for (int i = 0; i < frame_count; i++)
	{
		ordered_window[i] = window[(start_index + i) % frame_count];
	}

	for (int i = 0; i < g_handler_table_size; i++)
	{
		const handler_entry_t *entry = &g_handler_table[i];
		if (entry->attack_type != cfg->attack_type || entry->model != cfg->model)
		{
			continue;
		}

		if (frame_count != entry->window_size)
		{
			fprintf(
				stderr,
				"Error: %s expects frame_count=%d, got %d.\n",
				entry->label,
				entry->window_size,
				frame_count);
			return -1;
		}

		int pred = -1;
		entry->fn(ordered_window, &pred);
		double window_ts = ordered_window[frame_count - 1].timestamp;
		printf("[PRED] %s ts=%.6f prediction=%d\n", entry->label, window_ts, pred);
		fflush(stdout);

		// --- STATE MACHINE LOGIC FOR ATTACK SESSIONS (SILENT RECORDING) ---
		if (pred == 1)
		{
			g_total_attack_windows++;
			g_last_seen_attack_ts = ordered_window[frame_count - 1].timestamp;
			g_last_seen_attack_window = g_total_windows_processed;

			if (!g_in_attack_state)
			{
				g_in_attack_state = true;
				g_attack_session_count++;
				g_current_session_start_window = g_total_windows_processed;
				g_current_session_start_ts = ordered_window[0].timestamp;
			}

			printf("[ALERT] %s ts=%.6f attack_detected prediction=%d\n", entry->label, window_ts, pred);
			fflush(stdout);
		}
		else 
		{
			if (g_in_attack_state)
			{
				g_in_attack_state = false;
				double session_duration = g_last_seen_attack_ts - g_current_session_start_ts;
				
				// Store the session details in the array if space permits
				if (g_attack_session_count <= MAX_ATTACK_SESSIONS) 
				{
					int idx = g_attack_session_count - 1;
					g_session_history[idx].session_id = g_attack_session_count;
					g_session_history[idx].start_window = g_current_session_start_window;
					g_session_history[idx].end_window = g_total_windows_processed;
					g_session_history[idx].start_ts = g_current_session_start_ts;
					g_session_history[idx].end_ts = g_last_seen_attack_ts;
					g_session_history[idx].duration = session_duration;
				}
			}
		}
		// --- END STATE MACHINE LOGIC ---

		return 0;
	}

	/* Fallback: no handler registered for this (attack_type, model) combination. */
	printf("[WARN] no handler for attack=%s model=%s — using stub.\n",
		   attack_type_to_string(cfg->attack_type),
		   model_type_to_string(cfg->model));
	// process_can_window_x(window, start_index, frame_count, cfg);
	return -1;
}

static int hex_nibble(char c)
{
	if (c >= '0' && c <= '9')
	{
		return c - '0';
	}
	if (c >= 'a' && c <= 'f')
	{
		return c - 'a' + 10;
	}
	if (c >= 'A' && c <= 'F')
	{
		return c - 'A' + 10;
	}
	return -1;
}

static int parse_hex_data(const char *hex, uint8_t *out, int max_len)
{
	int len = (int)strlen(hex);
	if (len <= 0 || (len % 2) != 0)
	{
		return -1;
	}

	int byte_count = len / 2;
	if (byte_count > max_len)
	{
		return -1;
	}

	for (int i = 0; i < byte_count; i++)
	{
		int hi = hex_nibble(hex[i * 2]);
		int lo = hex_nibble(hex[i * 2 + 1]);
		if (hi < 0 || lo < 0)
		{
			return -1;
		}
		out[i] = (uint8_t)((hi << 4) | lo);
	}

	return byte_count;
}

static bool is_decimal_string(const char *value);
static const char *tdr_bus_id_from_interface(const char *interface_name, char *buffer, size_t buffer_size);
static const char *socket_interface_from_config(const app_config_t *cfg, char *buffer, size_t buffer_size);
static bool command_exists(const char *command);

/*
 * Expected tdr_can_dump line:
 *   CAN event: [1780890533510] 40000000 0000000000000000
 */
static bool parse_tdr_can_event_line(const char *line, CAN_Frame_t *sample)
{
	unsigned long long timestamp = 0;
	unsigned int id = 0;
	char data_hex[64] = {0};

	int matched = sscanf(line, "CAN event: [%llu] %x %63s", &timestamp, &id, data_hex);
	if (matched != 3)
	{
		return false;
	}

	memset(sample, 0, sizeof(*sample));
	sample->timestamp = (double)timestamp;
	sample->id = (uint32_t)id;

	int dlc = parse_hex_data(data_hex, sample->data, (int)sizeof(sample->data));
	if (dlc < 0)
	{
		fprintf(stderr, "WARN: invalid CAN data in line: %s", line);
		return false;
	}

	sample->dlc = dlc;
	return true;
}

static int listen_for_tdr_can_dump_frames(const app_config_t *cfg)
{
	if (cfg->frame_count <= 0 || cfg->frame_count > MAX_WINDOW_FRAMES)
	{
		fprintf(stderr, "Error: frame_count must be in range 1..%d.\n", MAX_WINDOW_FRAMES);
		return -1;
	}
	if (cfg->slide_percent <= 0 || cfg->slide_percent > 100)
	{
		fprintf(stderr, "Error: slide_percent must be in range 1..100.\n");
		return -1;
	}

	char bus_id[32];
	const char *tdr_bus_id = tdr_bus_id_from_interface(cfg->interface_name, bus_id, sizeof(bus_id));
	if (!is_decimal_string(tdr_bus_id))
	{
		fprintf(stderr, "WARN: invalid TDR bus id '%s' (expected digits). Falling back to SocketCAN.\n", tdr_bus_id);
		return -1;
	}

	char command[256];
	snprintf(command, sizeof(command), "tdr_can_dump %s 0 0", tdr_bus_id);

	FILE *pipe = popen(command, "r");
	if (pipe == NULL)
	{
		perror("popen(tdr_can_dump)");
		return -1;
	}

	CAN_Frame_t window[MAX_WINDOW_FRAMES];
	int filled = 0;
	int start_index = 0;
	int total_received = 0;
	int dispatch_step = (cfg->frame_count * cfg->slide_percent) / 100;
	if (dispatch_step <= 0)
	{
		dispatch_step = 1;
	}
	int next_dispatch_at = cfg->frame_count;

	const int has_deadline = (cfg->timeout_sec > 0);
	struct timespec deadline = {0, 0};
	if (has_deadline)
	{
		clock_gettime(CLOCK_MONOTONIC, &deadline);
		deadline.tv_sec += cfg->timeout_sec;
	}

	char line[512];
	while (!g_stop_requested && fgets(line, sizeof(line), pipe) != NULL)
	{
		if (has_deadline)
		{
			struct timespec now;
			clock_gettime(CLOCK_MONOTONIC, &now);
			long remaining_ns =
				(deadline.tv_sec - now.tv_sec) * 1000000000L +
				(deadline.tv_nsec - now.tv_nsec);
			if (remaining_ns <= 0)
			{
				printf("Timeout reached (%ds). Stopping.\n", cfg->timeout_sec);
				break;
			}
		}

		CAN_Frame_t sample;
		if (!parse_tdr_can_event_line(line, &sample))
		{
			/* Ignore non-frame lines, for example:
			 *   BUS event: Bus #0 - state = UP
			 */
			continue;
		}

		// --- Dummy Frame Filter for CHUB ---
		if ((sample.id & CAN_SFF_MASK) == 0x400 && sample.dlc == 8)
		{
			bool is_dummy = true;
			for (int i = 0; i < 8; i++)
			{
				if (sample.data[i] != 0x00)
				{
					is_dummy = false;
					break;
				}
			}
			if (is_dummy) continue; 
		}

		if (cfg->verbose)
		{
			printf("[TDR_CAN] ts=%.0f id=0x%08X dlc=%d data=",
				   sample.timestamp,
				   sample.id,
				   sample.dlc);
			for (int j = 0; j < sample.dlc; j++)
			{
				printf("%02X", sample.data[j]);
				if (j + 1 < sample.dlc)
				{
					printf(" ");
				}
			}
			printf("\n");
		}

		if (filled < cfg->frame_count)
		{
			window[filled] = sample;
			filled++;
		}
		else
		{
			window[start_index] = sample;
			start_index = (start_index + 1) % cfg->frame_count;
		}

		total_received++;

		if (filled == cfg->frame_count && total_received >= next_dispatch_at)
		{
			if (dispatch_process_window(window, start_index, cfg->frame_count, cfg) != 0)
			{
				pclose(pipe);
				return -1;
			}
			next_dispatch_at += dispatch_step;
		}
	}

	int rc = pclose(pipe);
	if (rc != 0 && !g_stop_requested)
	{
		fprintf(stderr, "WARN: tdr_can_dump exited with status=%d.\n", rc);
	}

	printf("Stop signal received. Exiting TDR CAN dump loop.\n");
	return 0;
}


static bool is_decimal_string(const char *value)
{
	if (value == NULL || *value == '\0')
	{
		return false;
	}

	for (const char *p = value; *p != '\0'; p++)
	{
		if (!isdigit((unsigned char)*p))
		{
			return false;
		}
	}

	return true;
}

static const char *tdr_bus_id_from_interface(const char *interface_name, char *buffer, size_t buffer_size)
{
	if (interface_name == NULL)
	{
		return "0";
	}

	/* Allow both --interface 0 and --interface can0.
	 * tdr_can_dump expects bus-id, while SocketCAN expects interface name.
	 */
	if (strncmp(interface_name, "can", 3) == 0 && is_decimal_string(interface_name + 3))
	{
		snprintf(buffer, buffer_size, "%s", interface_name + 3);
		return buffer;
	}

	return interface_name;
}

static const char *socket_interface_from_config(const app_config_t *cfg, char *buffer, size_t buffer_size)
{
	if (cfg->interface_name != NULL && is_decimal_string(cfg->interface_name))
	{
		snprintf(buffer, buffer_size, "can%s", cfg->interface_name);
		return buffer;
	}

	return cfg->interface_name;
}

static bool command_exists(const char *command)
{
	char check_command[256];
	snprintf(check_command, sizeof(check_command), "command -v %s >/dev/null 2>&1", command);
	return system(check_command) == 0;
}

static int listen_for_can_frames(int fd, const app_config_t *cfg)
{
	if (cfg->frame_count <= 0 || cfg->frame_count > MAX_WINDOW_FRAMES)
	{
		fprintf(stderr, "Error: frame_count must be in range 1..%d.\n", MAX_WINDOW_FRAMES);
		return -1;
	}
	if (cfg->slide_percent <= 0 || cfg->slide_percent > 100)
	{
		fprintf(stderr, "Error: slide_percent must be in range 1..100.\n");
		return -1;
	}

	CAN_Frame_t window[MAX_WINDOW_FRAMES];
	int filled = 0;
	int start_index = 0;
	int total_received = 0;
	int dispatch_step = (cfg->frame_count * cfg->slide_percent) / 100;
	if (dispatch_step <= 0)
	{
		dispatch_step = 1;
	}
	int next_dispatch_at = cfg->frame_count;

	const int has_deadline = (cfg->timeout_sec > 0);
	struct timespec deadline = {0, 0};
	if (has_deadline)
	{
		clock_gettime(CLOCK_MONOTONIC, &deadline);
		deadline.tv_sec += cfg->timeout_sec;
	}

	while (!g_stop_requested)
	{
		if (has_deadline)
		{
			struct timespec now;
			clock_gettime(CLOCK_MONOTONIC, &now);
			long remaining_ns =
				(deadline.tv_sec - now.tv_sec) * 1000000000L +
				(deadline.tv_nsec - now.tv_nsec);
			if (remaining_ns <= 0)
			{
				printf("Timeout reached (%ds). Stopping.\n", cfg->timeout_sec);
				break;
			}
			fd_set rfds;
			FD_ZERO(&rfds);
			FD_SET(fd, &rfds);
			struct timeval tv;
			tv.tv_sec = remaining_ns / 1000000000L;
			tv.tv_usec = (remaining_ns % 1000000000L) / 1000L;
			int sel = select(fd + 1, &rfds, NULL, NULL, &tv);
			if (sel < 0)
			{
				if (errno == EINTR && g_stop_requested)
					break;
				perror("select");
				return -1;
			}
			if (sel == 0)
			{
				printf("Timeout reached (%ds). Stopping.\n", cfg->timeout_sec);
				break;
			}
		}

		struct can_frame frame;
		ssize_t nread = read(fd, &frame, sizeof(frame));
		if (nread < 0)
		{
			if (errno == EINTR && g_stop_requested)
			{
				break;
			}
			perror("read(can_frame)");
			return -1;
		}

		if ((size_t)nread < sizeof(struct can_frame))
		{
			fprintf(stderr, "Short CAN frame read (%zd bytes).\n", nread);
			return -1;
		}

		CAN_Frame_t sample;
		sample.timestamp = now_timestamp_s();
		sample.id = frame.can_id & CAN_SFF_MASK;
		sample.dlc = frame.can_dlc;
		memset(sample.data, 0, sizeof(sample.data));
		memcpy(sample.data, frame.data, (size_t)frame.can_dlc);

		// --- Dummy Frame Filter for SocketCAN ---
		if ((sample.id & CAN_SFF_MASK) == 0x400 && sample.dlc == 8)
		{
			bool is_dummy = true;
			for (int i = 0; i < 8; i++)
			{
				if (sample.data[i] != 0x00)
				{
					is_dummy = false;
					break;
				}
			}
			if (is_dummy) continue; 
		}

		if (cfg->verbose)
		{
			printf("[CAN] ts=%.6f id=0x%03X dlc=%d data=", sample.timestamp, sample.id & CAN_SFF_MASK, sample.dlc);
			for (int j = 0; j < sample.dlc; j++)
			{
				printf("%02X", sample.data[j]);
				if (j + 1 < sample.dlc)
				{
					printf(" ");
				}
			}
			printf("\n");
		}

		if (filled < cfg->frame_count)
		{
			window[filled] = sample;
			filled++;
		}
		else
		{
			window[start_index] = sample;
			start_index = (start_index + 1) % cfg->frame_count;
		}

		total_received++;

		if (filled == cfg->frame_count && total_received >= next_dispatch_at)
		{
			if (dispatch_process_window(window, start_index, cfg->frame_count, cfg) != 0)
			{
				return -1;
			}
			next_dispatch_at += dispatch_step;
		}
	}

	printf("Stop signal received. Exiting CAN listen loop.\n");

	return 0;
}
#endif

static void print_help(const char *prog_name)
{
	printf("%s v%s\n", prog_name, APP_VERSION);
	printf("\n");
	printf("Usage: %s --attack-type <dos|fuzzy|gear|rpm> --model <dt|tnn|lr> --interface <can0|0|vcan0|...>\n",
		   prog_name);
	printf("\n");
	printf("Options:\n");
	printf("  -a, --attack-type   Attack type: dos, fuzzy, gear, rpm\n");
	printf("  -m, --model         Model (mode): dt, tnn, lr\n");
	printf("      --mode          Alias of --model\n");
	printf("  -i, --interface     CAN source. tdr_can_dump uses bus id 0; SocketCAN uses can0/vcan0.\n");
	printf("  -s, --slide-percent Sliding hop as %% of frame_count, example: 10, 30, 50 (default: 50)\n");
	printf("  -t, --timeout       Stop after N seconds (<=0 = run forever, default: 0)\n");
	printf("  -v, --verbose       Print each CAN message in detail\n");
	printf("  -V, --version       Show version\n");
	printf("  -h, --help          Show this help message\n");
	printf("\n");
	printf("Example:\n");
	printf("  %s --attack-type dos --model tnn --interface 0\n", prog_name);
	printf("  %s --attack-type dos --model tnn --interface vcan0 --slide-percent 30\n", prog_name);
	printf("  Stop listening with Ctrl+C (SIGINT) or kill (SIGTERM).\n");
}

static attack_type_t parse_attack_type(const char *value)
{
	if (value == NULL)
	{
		return ATTACK_UNKNOWN;
	}

	if (strcmp(value, "dos") == 0)
	{
		return ATTACK_DOS;
	}
	if (strcmp(value, "fuzzy") == 0)
	{
		return ATTACK_FUZZY;
	}
	if (strcmp(value, "gear") == 0)
	{
		return ATTACK_GEAR;
	}
	if (strcmp(value, "rpm") == 0)
	{
		return ATTACK_RPM;
	}

	return ATTACK_UNKNOWN;
}

static model_type_t parse_model_type(const char *value)
{
	if (value == NULL)
	{
		return MODEL_UNKNOWN;
	}

	if (strcmp(value, "dt") == 0)
	{
		return MODEL_DT;
	}
	if (strcmp(value, "tnn") == 0)
	{
		return MODEL_TNN;
	}
	if (strcmp(value, "lr") == 0)
	{
		return MODEL_LR;
	}

	return MODEL_UNKNOWN;
}

static const char *attack_type_to_string(attack_type_t attack_type)
{
	switch (attack_type)
	{
	case ATTACK_DOS:
		return "dos";
	case ATTACK_FUZZY:
		return "fuzzy";
	case ATTACK_GEAR:
		return "gear";
	case ATTACK_RPM:
		return "rpm";
	default:
		return "unknown";
	}
}

static const char *model_type_to_string(model_type_t model)
{
	switch (model)
	{
	case MODEL_DT:
		return "dt";
	case MODEL_TNN:
		return "tnn";
	case MODEL_LR:
		return "lr";
	default:
		return "unknown";
	}
}

static int select_frame_count(attack_type_t attack_type, model_type_t model)
{
	for (int i = 0; i < g_handler_table_size; i++)
	{
		if (g_handler_table[i].attack_type == attack_type &&
			g_handler_table[i].model == model)
		{
			return g_handler_table[i].window_size;
		}
	}
	return DEFAULT_WINDOW_SIZE;
}

static bool parse_arguments(int argc, char **argv, app_config_t *cfg)
{
	static const struct option long_options[] = {
		{"attack-type", required_argument, NULL, 'a'},
		{"model", required_argument, NULL, 'm'},
		{"mode", required_argument, NULL, 'm'},
		{"interface", required_argument, NULL, 'i'},
		{"slide-percent", required_argument, NULL, 's'},
		{"timeout", required_argument, NULL, 't'},
		{"verbose", no_argument, NULL, 'v'},
		{"version", no_argument, NULL, 'V'},
		{"help", no_argument, NULL, 'h'},
		{0, 0, 0, 0},
	};

	int opt = 0;
	while ((opt = getopt_long(argc, argv, "a:m:i:s:t:vVh", long_options, NULL)) != -1)
	{
		switch (opt)
		{
		case 'a':
			cfg->attack_type = parse_attack_type(optarg);
			if (cfg->attack_type == ATTACK_UNKNOWN)
			{
				fprintf(stderr, "Error: invalid attack type '%s'. Use dos|fuzzy|gear|rpm.\n", optarg);
				return false;
			}
			break;
		case 'm':
			cfg->model = parse_model_type(optarg);
			if (cfg->model == MODEL_UNKNOWN)
			{
				fprintf(stderr, "Error: invalid model '%s'. Use dt|tnn|lr.\n", optarg);
				return false;
			}
			break;
		case 'i':
			cfg->interface_name = optarg;
			if (cfg->interface_name[0] == '\0')
			{
				fprintf(stderr, "Error: interface must not be empty.\n");
				return false;
			}
			break;
		case 's':
		{
			char *endptr = NULL;
			long val = strtol(optarg, &endptr, 10);
			if (endptr == optarg || *endptr != '\0')
			{
				fprintf(stderr, "Error: invalid slide_percent '%s'. Must be an integer.\n", optarg);
				return false;
			}
			if (val <= 0 || val > 100)
			{
				fprintf(stderr, "Error: slide_percent must be in range 1..100.\n");
				return false;
			}
			cfg->slide_percent = (int)val;
			break;
		}
		case 't':
		{
			char *endptr = NULL;
			long val = strtol(optarg, &endptr, 10);
			if (endptr == optarg || *endptr != '\0')
			{
				fprintf(stderr, "Error: invalid timeout '%s'. Must be an integer.\n", optarg);
				return false;
			}
			cfg->timeout_sec = (int)val;
			break;
		}
		case 'v':
			cfg->verbose = true;
			break;
		case 'V':
			printf("%s\n", APP_VERSION);
			exit(EXIT_SUCCESS);
		case 'h':
			print_help(argv[0]);
			exit(EXIT_SUCCESS);
		default:
			print_help(argv[0]);
			return false;
		}
	}

	if (cfg->attack_type == ATTACK_UNKNOWN || cfg->model == MODEL_UNKNOWN || cfg->interface_name == NULL)
	{
		fprintf(stderr, "Error: missing required arguments.\n\n");
		print_help(argv[0]);
		return false;
	}

	return true;
}

int main(int argc, char **argv)
{
	app_config_t cfg = {
		.attack_type = ATTACK_UNKNOWN,
		.model = MODEL_UNKNOWN,
		.interface_name = NULL,
		.frame_count = 10,
		.slide_percent = 50,
		.timeout_sec = 0,
		.verbose = false,
	};

	if (!parse_arguments(argc, argv, &cfg))
	{
		return EXIT_FAILURE;
	}

	/* Frame count is selected from the (attack_type, model) combination. */
	cfg.frame_count = select_frame_count(cfg.attack_type, cfg.model);

	printf("Tiny CAN IDS app starting...\n");
	printf("  attack_type: %s\n", attack_type_to_string(cfg.attack_type));
	printf("  model      : %s\n", model_type_to_string(cfg.model));
	printf("  interface  : %s\n", cfg.interface_name);
	printf("  frame_count: %d\n", cfg.frame_count);
	printf("  slide_pct  : %d%%\n", cfg.slide_percent);
	printf("  verbose    : %s\n", cfg.verbose ? "on" : "off");
	if (cfg.timeout_sec > 0)
	{
		printf("  timeout    : %ds\n", cfg.timeout_sec);
	}
	else
	{
		printf("  timeout    : none (run forever)\n");
	}

#ifdef __linux__
	printf("  frames     : %d\n", cfg.frame_count);

	signal(SIGINT, handle_stop_signal);
	signal(SIGTERM, handle_stop_signal);

	if (command_exists("tdr_can_dump"))
	{
		char bus_id[32];
		const char *tdr_bus_id = tdr_bus_id_from_interface(cfg.interface_name, bus_id, sizeof(bus_id));
		printf("tdr_can_dump found. Starting TDR CAN dump on bus '%s'. Listening...\n", tdr_bus_id);
		int listen_rc = listen_for_tdr_can_dump_frames(&cfg);
		if (listen_rc == 0 || g_stop_requested)
		{
			goto print_summary;
		}

		fprintf(stderr, "WARN: tdr_can_dump failed. Falling back to SocketCAN.\n");
	}
	else
	{
		printf("tdr_can_dump not found. Falling back to SocketCAN.\n");
	}

	char socket_if_name[IFNAMSIZ];
	const char *socket_interface = socket_interface_from_config(&cfg, socket_if_name, sizeof(socket_if_name));
	app_config_t socket_cfg = cfg;
	socket_cfg.interface_name = socket_interface;

	int can_fd = open_can_socket(socket_cfg.interface_name);
	if (can_fd < 0)
	{
		return EXIT_FAILURE;
	}

	printf("SocketCAN bound on '%s'. Listening...\n", socket_cfg.interface_name);
	listen_for_can_frames(can_fd, &socket_cfg);
	close(can_fd);

print_summary:
	// Close ongoing session if interrupted by Ctrl+C
	if (g_in_attack_state)
	{
		g_in_attack_state = false;
		double session_duration = g_last_seen_attack_ts - g_current_session_start_ts;
		
		if (g_attack_session_count <= MAX_ATTACK_SESSIONS) 
		{
			int idx = g_attack_session_count - 1;
			g_session_history[idx].session_id = g_attack_session_count;
			g_session_history[idx].start_window = g_current_session_start_window;
			g_session_history[idx].end_window = g_last_seen_attack_window; 
			g_session_history[idx].start_ts = g_current_session_start_ts;
			g_session_history[idx].end_ts = g_last_seen_attack_ts;
			g_session_history[idx].duration = session_duration;
		}
	}

	// --- 1. PRINT ATTACK SESSION HISTORY ---
	printf("\n======================================================\n");
	printf(" ATTACK SESSION HISTORY\n");
	printf("======================================================\n");
	if (g_attack_session_count == 0) 
	{
		printf(" No attack sessions recorded.\n");
	} 
	else 
	{
		int limit = (g_attack_session_count > MAX_ATTACK_SESSIONS) ? MAX_ATTACK_SESSIONS : g_attack_session_count;
		for (int i = 0; i < limit; i++) 
		{
			printf(" [Session #%02d] Windows: %d -> %d\n", 
				   g_session_history[i].session_id, 
				   g_session_history[i].start_window, 
				   g_session_history[i].end_window);
			printf("               Start TS : %.6f\n", g_session_history[i].start_ts);
			printf("               End TS   : %.6f\n", g_session_history[i].end_ts);
			printf("               Duration : %.6f sec\n", g_session_history[i].duration);
			
			if (i < limit - 1) printf(" ----------------------------------------------------\n");
		}
		if (g_attack_session_count > MAX_ATTACK_SESSIONS) 
		{
			printf(" ... (Additional %d sessions not displayed due to memory limit)\n", 
				   g_attack_session_count - MAX_ATTACK_SESSIONS);
		}
	}

	// --- 2. PRINT STATISTICAL SUMMARY REPORT ---
	printf("\n======================================================\n");
	printf(" DETECTION SUMMARY REPORT\n");
	printf("======================================================\n");
	printf(" Total Windows Processed : %d\n", g_total_windows_processed);
	printf(" Total Attack Windows    : %d\n", g_total_attack_windows);
	printf(" Total Attack Sessions   : %d\n", g_attack_session_count);
	printf("======================================================\n");

#else
	fprintf(stderr, "Error: this app is supported only on Linux (SocketCAN).\n");
	return EXIT_FAILURE;
#endif

	return EXIT_SUCCESS;
}